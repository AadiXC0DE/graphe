{
  "name": "graphe",
  "version": "1.0.3",
  "private": true,
  "description": "An agentic coding platform for the desktop, built on pi",
  "license": "MIT",
  "author": "Graphe contributors",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "dist-electron/boot.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/run-electron-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:migration": "vitest run tests/scenarios/migration.test.ts",
    "test:extensions": "vitest run tests/extension-trust.test.ts tests/extension-ui.test.ts tests/extension-request.test.ts tests/extension-probe.test.ts tests/extension-probe-child.test.ts tests/tool-conflicts.test.ts tests/package-activation.test.ts tests/packages.test.ts",
    "test:perf": "node scripts/perf-report.mjs --check",
    "budget:compare": "node scripts/budget-compare.mjs",
    "test:measure": "node scripts/measure-runtime.mjs",
    "test:visual": "node scripts/visual-matrix.mjs",
    "test:watch": "vitest",
    "shot": "node scripts/screenshot.mjs",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "shot:serve": "node scripts/dev-daemon.mjs && node scripts/screenshot.mjs",
    "app:build": "node scripts/build-electron.mjs",
    "app:electron": "npm run app:build && electron .",
    "app": "concurrently -k -n vite,app -c gray,cyan \"node scripts/dev-server.mjs\" \"npm run app:electron\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package-app.mjs",
    "package:quick": "node scripts/package-app.mjs --arm64",
    "verify:package": "node scripts/verify-package.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:json": "node scripts/eval.mjs --json",
    "lint": "eslint .",
    "copy:check": "node scripts/no-dashes.mjs",
    "check": "npm run typecheck && npm run copy:check && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.4.3",
    "sql.js": "^1.14.2",
    "typebox": "^1.3.31",
    "unpdf": "^1.8.1",
    "use-stick-to-bottom": "^1.1.6"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "agentic-ai",
    "autonomous-agents",
    "ai-pair-programming",
    "code-generation",
    "llm",
    "developer-tools",
    "electron",
    "typescript",
    "react",
    "macos",
    "desktop-app",
    "figma",
    "design-systems",
    "pi"
  ]
}
