{
  "name": "graphe",
  "version": "0.0.1",
  "private": true,
  "description": "A gentle coding agent for designers",
  "license": "MIT",
  "author": "Graphe contributors",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/screenshot.mjs",
    "app:build": "node scripts/build-electron.mjs",
    "app:electron": "npm run app:build && electron .",
    "app": "concurrently -k -n vite,app -c gray,cyan \"node scripts/dev-server.mjs\" \"npm run app:electron\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package-app.mjs",
    "package:quick": "node scripts/package-app.mjs --arm64",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "marked": "^18.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.4.2",
    "typebox": "^1.3.7",
    "use-stick-to-bottom": "^1.1.6"
  }
}
