{
  "name": "graphe",
  "version": "0.8.4",
  "private": true,
  "description": "An agentic coding platform for the desktop, built on pi",
  "license": "MIT",
  "author": "Graphe contributors",
  "type": "module",
  "main": "dist-electron/boot.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/screenshot.mjs",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "shot:serve": "node scripts/dev-daemon.mjs && node scripts/screenshot.mjs",
    "app:build": "node scripts/build-electron.mjs",
    "app:electron": "npm run app:build && electron .",
    "app": "concurrently -k -n vite,app -c gray,cyan \"node scripts/dev-server.mjs\" \"npm run app:electron\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "postinstall": "node scripts/patch-pi-glob.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package-app.mjs",
    "package:quick": "node scripts/package-app.mjs --arm64",
    "verify:package": "node scripts/verify-package.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:json": "node scripts/eval.mjs --json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glob": "^7.2.3",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.4.2",
    "sql.js": "^1.14.2",
    "typebox": "^1.3.7",
    "unpdf": "^0.12.2",
    "use-stick-to-bottom": "^1.1.6"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "agentic-ai",
    "autonomous-agents",
    "ai-pair-programming",
    "code-generation",
    "llm",
    "developer-tools",
    "electron",
    "typescript",
    "react",
    "macos",
    "desktop-app",
    "figma",
    "design-systems",
    "pi"
  ]
}
